<Window x:Class="ActiveDot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ActiveDot 设置"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MinHeight="380"
        Width="390">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14,8,14,8">
        <!-- 启用/禁用 -->
        <CheckBox x:Name="ckEnabled" Content="启用闪烁" FontWeight="SemiBold" Margin="0,0,0,5"
                  Checked="CkEnabled_Changed" Unchecked="CkEnabled_Changed"/>

        <!-- 尺寸 -->
        <GroupBox Header="尺寸 (1-64)" Margin="0,2,0,8">
            <StackPanel Orientation="Horizontal" Margin="10,10">
                <TextBlock Text="宽" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtWidth" Text="4"/>
                <TextBlock Text=" 高" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox x:Name="txtHeight" Text="4"/>
            </StackPanel>
        </GroupBox>

        <!-- 位置 -->
        <GroupBox Header="位置" Margin="0,2,0,8">
            <StackPanel Margin="10,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="X坐标" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtX" GotKeyboardFocus="TxtPos_GotFocus"/>
                    <TextBlock Text=" Y坐标" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="txtY" GotKeyboardFocus="TxtPos_GotFocus"/>
                    <CheckBox x:Name="ckDrag" Content="可拖动模式" VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="CkDrag_Changed" Unchecked="CkDrag_Changed"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 亮度增量 -->
        <GroupBox Header="亮度变化 (1-10)" Margin="0,2,0,8">
            <StackPanel Orientation="Horizontal" Margin="10,10">
                <Slider x:Name="sldDelta" Minimum="1" Maximum="10" TickFrequency="1"
                        IsSnapToTickEnabled="True" Width="290" ValueChanged="SldDelta_Changed"/>
                <TextBlock x:Name="lblDelta" Text="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 闪烁频率 -->
        <GroupBox Header="闪烁频率 (1-100)" Margin="0,2,0,8">
            <StackPanel Orientation="Horizontal" Margin="10,10">
                <TextBox x:Name="txtHz" Text="20" Width="30" TextChanged="TxtHz_Changed"/>
                <TextBlock Text="Hz（受显示器刷新率、系统限制、显卡性能等上限制约）" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Opacity="0.7"/>
            </StackPanel>
        </GroupBox>

        <!-- 其他 -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox x:Name="ckAutoStart" Content="开机自启" VerticalAlignment="Center"
                      Checked="CkAutoStart_Changed" Unchecked="CkAutoStart_Changed"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
            <Button x:Name="btnSave" Content="保存并应用" Click="BtnSave_Click"/>
            <Button x:Name="btnClose" Content="关闭" Click="BtnClose_Click" Margin="0,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>